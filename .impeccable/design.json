  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one primary action per view.",
      "html": "<button class=\"ds-btn-primary\">Mulai try out</button>",
      "css": ".ds-btn-primary{background:var(--color-primary,#0071e3);color:#fff;height:40px;padding:0 20px;border:0;border-radius:9999px;font:500 15px/1 -apple-system,BlinkMacSystemFont,Inter,sans-serif;letter-spacing:-0.01em;cursor:pointer;transition:background-color .2s cubic-bezier(.32,.72,0,1),transform .2s cubic-bezier(.32,.72,0,1)}.ds-btn-primary:hover{background:var(--color-primary-hover,#0077ed)}.ds-btn-primary:active{transform:scale(.97)}.ds-btn-primary:focus-visible{outline:3px solid rgb(0 113 227 / .5);outline-offset:2px}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Back, cancel, and low-emphasis actions.",
      "html": "<button class=\"ds-btn-secondary\">Periksa lagi</button>",
      "css": ".ds-btn-secondary{background:#e8e8ed;color:#1d1d1f;height:40px;padding:0 20px;border:0;border-radius:9999px;font:500 15px/1 -apple-system,BlinkMacSystemFont,Inter,sans-serif;cursor:pointer;transition:background-color .2s}.ds-btn-secondary:hover{background:#dcdce1}.ds-btn-secondary:active{transform:scale(.97)}.ds-btn-secondary:focus-visible{outline:3px solid rgb(0 113 227 / .5);outline-offset:2px}"
    },
    {
      "name": "Chevron Link",
      "kind": "custom",
      "refersTo": "button-tinted",
      "description": "Every secondary next step: blue text with a trailing chevron.",
      "html": "<a class=\"ds-link\" href=\"#\">Sudah punya akun? Masuk <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m9 18 6-6-6-6\"/></svg></a>",
      "css": ".ds-link{display:inline-flex;align-items:center;gap:2px;color:#0066cc;font:400 17px/1.4 -apple-system,BlinkMacSystemFont,Inter,sans-serif;text-decoration:none}.ds-link:hover{text-decoration:underline;text-underline-offset:4px}.ds-link:focus-visible{outline:3px solid rgb(0 113 227 / .5);outline-offset:2px;border-radius:6px}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Single field with a blue focus ring.",
      "html": "<input class=\"ds-input\" placeholder=\"misal: Try Out Bahasa Inggris\" />",
      "css": ".ds-input{height:44px;width:280px;padding:0 14px;border:1px solid #d2d2d7;border-radius:18px;background:#fff;color:#1d1d1f;font:400 15px/1 -apple-system,BlinkMacSystemFont,Inter,sans-serif;caret-color:#0071e3;outline:none;transition:border-color .2s,box-shadow .2s}.ds-input::placeholder{color:#6e6e73}.ds-input:focus-visible{border-color:#0071e3;box-shadow:0 0 0 4px rgb(0 113 227 / .15)}"
    },
    {
      "name": "Segmented Control",
      "kind": "nav",
      "refersTo": "segmented-control",
      "description": "iOS segmented control with a sliding white thumb.",
      "html": "<div class=\"ds-seg\"><span class=\"ds-seg-thumb\"></span><button class=\"ds-seg-on\">Masuk</button><button>Daftar</button></div>",
      "css": ".ds-seg{position:relative;display:grid;grid-template-columns:1fr 1fr;width:240px;height:36px;padding:2px;border-radius:10px;background:rgb(120 120 128 / .12)}.ds-seg-thumb{position:absolute;top:2px;bottom:2px;left:2px;width:calc(50% - 2px);border-radius:8px;background:#fff;box-shadow:0 3px 8px rgb(0 0 0 / .12),0 3px 1px rgb(0 0 0 / .04)}.ds-seg button{position:relative;z-index:1;border:0;background:none;font:500 13px/1 -apple-system,BlinkMacSystemFont,Inter,sans-serif;color:rgb(29 29 31 / .7);cursor:pointer}.ds-seg button:hover{color:#1d1d1f}.ds-seg .ds-seg-on{font-weight:600;color:#1d1d1f}"
    },
    {
      "name": "Answer Option",
      "kind": "custom",
      "refersTo": "option-row",
      "description": "Exam answer row; selected state shows a blue hairline and checkmark.",
      "html": "<button class=\"ds-opt\"><span class=\"ds-opt-l\">A</span>40</button><button class=\"ds-opt ds-opt-on\"><span class=\"ds-opt-l\">B</span>28<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#0071e3\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"margin-left:auto\"><path d=\"M20 6 9 17l-5-5\"/></svg></button>",
      "css": ".ds-opt{display:flex;align-items:center;gap:16px;width:360px;margin:6px 0;padding:14px 16px;border:1px solid rgb(0 0 0 / .08);border-radius:22px;background:#fff;color:#1d1d1f;font:400 17px/1.4 -apple-system,BlinkMacSystemFont,Inter,sans-serif;text-align:left;cursor:pointer;transition:background-color .2s,border-color .2s,box-shadow .2s}.ds-opt:hover{border-color:#d2d2d7;background:#f7f7f9}.ds-opt:focus-visible{outline:3px solid rgb(0 113 227 / .5);outline-offset:2px}.ds-opt-l{display:flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:50%;background:rgb(120 120 128 / .12);color:#6e6e73;font-size:14px;font-weight:600}.ds-opt-on{border-color:#0071e3;background:rgb(0 113 227 / .06);box-shadow:0 0 0 1px #0071e3}.ds-opt-on .ds-opt-l{background:#0071e3;color:#fff}"
    },
    {
      "name": "Timer Pill",
      "kind": "chip",
      "refersTo": "timer-pill",
      "description": "Running clock; orange under five minutes, red in the last minute.",
      "html": "<span class=\"ds-timer\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 18 18\" style=\"transform:rotate(-90deg)\"><circle cx=\"9\" cy=\"9\" r=\"6.5\" fill=\"none\" stroke=\"currentColor\" stroke-opacity=\".2\" stroke-width=\"2.5\"/><circle cx=\"9\" cy=\"9\" r=\"6.5\" fill=\"none\" stroke=\"#ff9500\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-dasharray=\"40.8\" stroke-dashoffset=\"30\"/></svg>03:39</span>",
      "css": ".ds-timer{display:inline-flex;align-items:center;gap:8px;height:36px;padding:0 14px 0 10px;border-radius:9999px;background:rgb(255 149 0 / .15);color:#b33900;font:600 15px/1 -apple-system,BlinkMacSystemFont,Inter,sans-serif;font-variant-numeric:tabular-nums}"
    },
    {
      "name": "Surface Card",
      "kind": "card",
      "refersTo": "card",
